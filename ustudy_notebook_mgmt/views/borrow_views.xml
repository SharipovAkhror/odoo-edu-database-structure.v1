<!-- views/borrow_views.xml -->
<odoo>

  <!-- LIST -->
  <record id="view_edu_notebook_borrow_list" model="ir.ui.view">
    <field name="name">edu.notebook.borrow.list</field>
    <field name="model">edu.notebook.borrow</field>
    <field name="arch" type="xml">
      <list>
        <field name="notebook_id"/>
        <field name="student_id"/>

        <field name="start_datetime" string="Boshlanish sana/vaqt"/>
        <field name="return_datetime" string="Qaytarish sana/vaqt"/>

        <field name="duration_hours" string="Soat"/>
        <field name="hourly_price" string="Soatlik narx"/>
        <field name="total_amount" string="Jami narx"/>

        <field name="state" widget="badge" string="Holat"
               decoration-info="state == 'draft'"
               decoration-success="state == 'active'"
               decoration-warning="state == 'returned'"
               decoration-danger="state == 'cancelled'"/>
      </list>
    </field>
  </record>

  <!-- FORM -->
  <record id="view_edu_notebook_borrow_form" model="ir.ui.view">
    <field name="name">edu.notebook.borrow.form</field>
    <field name="model">edu.notebook.borrow</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,active,returned,cancelled"/>

          <!-- Draft: Borrow -->
          <button name="action_confirm_borrow" type="object"
                  string="Ijaraga berish" class="btn-primary"
                  modifiers="{'invisible': [['state','!=','draft']]}"/>

          <!-- Active: Return -->
          <button name="action_return" type="object"
                  string="Qaytarish" class="btn-success"
                  modifiers="{'invisible': [['state','!=','active']]}"/>

          <!-- Draft + Active: Cancel -->
          <button name="action_cancel" type="object"
                  string="Bekor qilish" class="btn-secondary"
                  modifiers="{'invisible': [['state','not in',['draft','active']]]}"/>
        </header>

        <sheet>
          <group>
            <group>
              <field name="notebook_id" required="1"/>
              <field name="student_id" required="1"/>
            </group>

            <group>
              <field name="start_datetime" required="1" string="Boshlanish sana/vaqt"
                     readonly="state != 'draft'"/>
              <field name="return_datetime" string="Qaytarish sana/vaqt" readonly="1"
                     modifiers="{'invisible': [['state','!=','returned']]}"/>
              <field name="duration_hours" readonly="1" string="Soat"/>
            </group>
          </group>

          <group string="To'lov" class="mt16">
            <field name="hourly_price" string="Soatlik narx"/>
            <field name="total_amount" string="Jami narx" readonly="1"/>
            <field name="currency_id" invisible="1"/>
          </group>
        </sheet>

        <chatter/>
      </form>
    </field>
  </record>

  <!-- ACTION -->
  <record id="action_edu_notebook_borrow" model="ir.actions.act_window">
    <field name="name">Borrowing</field>
    <field name="res_model">edu.notebook.borrow</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
