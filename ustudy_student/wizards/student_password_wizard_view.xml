<odoo>
    <record id="student_password_wizard_form" model="ir.ui.view">
        <field name="name">student.password.wizard.form</field>
        <field name="model">student.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Student Password">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="new_password" password="True"/>
                </group>
                <footer>
                    <button string="Set Password" type="object" name="action_set_password" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="student_password_wizard_action" model="ir.actions.act_window">
        <field name="name">Set Password</field>
        <field name="res_model">student.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>
</odoo>
