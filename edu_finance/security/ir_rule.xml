<odoo>
    <record id="cc_finance_rule_by_company" model="ir.rule">
        <field name="name">Finance company filter</field>
        <field name="model_id" ref="model_cc_finance"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="cc_finance_portal_rule" model="ir.rule">
        <field name="name">Portal Finance Own Records</field>
        <field name="model_id" ref="your_module.model_cc_finance"/>
        <field name="domain_force">[('partner_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
