<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Employee Form View Extension -->
    <record id="view_employee_form_finance" model="ir.ui.view">
        <field name="name">hr.employee.form.finance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_finances" type="object"
                        class="oe_stat_button" icon="fa-money">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="finance_balance" widget="monetary"/>
                        </span>
                        <span class="o_stat_text">Balance</span>
                    </div>
                </button>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Finance" name="finance_page">
                    <group>
                        <group>
                            <!-- Hidden field to check if user is admin -->
                            <field name="is_user_admin" invisible="1"/>
                            
                            <!-- Admin-only editable field BEFORE finance_balance -->
                            <!-- Visible to all, but readonly for non-administrators -->
                            <field name="finance_adjustment" 
                                   widget="percentage"
                                   readonly="not is_user_admin"/>
                            
                            <field name="finance_balance" 
                                   widget="monetary" 
                                   readonly="1"/>
                            
                            <field name="finance_count" invisible="1"/>
                        </group>
                    </group>
                    <field name="finance_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="name"/>
                            <field name="transaction_type"/>
                            <field name="payment_type_id"/>
                            <field name="amount" sum="Total"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    
</odoo>