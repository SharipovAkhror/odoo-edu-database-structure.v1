<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Payment Method Form View -->
    <record id="view_payment_method_form" model="ir.ui.view">
        <field name="name">cc.payment.method.form</field>
        <field name="model">cc.payment.method</field>
        <field name="arch" type="xml">
            <form string="Payment Method">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Payment Method Tree View -->
    <record id="view_payment_method_tree" model="ir.ui.view">
        <field name="name">cc.payment.method.list</field>
        <field name="model">cc.payment.method</field>
        <field name="arch" type="xml">
            <list string="Payment Methods" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Payment Method Action -->
    <record id="action_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">cc.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>
    
</odoo>