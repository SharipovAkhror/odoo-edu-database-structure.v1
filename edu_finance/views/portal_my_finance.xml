<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_finance" name="My Finance Reports">
        <t t-call="portal.portal_layout">

            <t t-set="breadcrumbs"
               t-value="[(('/my/home'), 'Mening hisobim'), (('/my/finance'), 'Mening Hisobotlarim')]"/>

            <div class="container mt-4">
                <h3 class="mb-4">Mening Hisobotlarim</h3>

                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Sana</th>
                            <th>Xizmat raqami</th>
                            <th>Turi</th>
                            <th>To‘lov turi</th>
                            <th>Miqdor</th>
                            <th>Holat</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-foreach="records" t-as="rec">
                            <tr>
                                <td><span t-esc="rec.date"/></td>
                                <td><span t-esc="rec.name"/></td>
                                <td>
                                    <span t-if="rec.transaction_type == 'income'" class="badge bg-success">
                                        Daromad
                                    </span>
                                    <span t-if="rec.transaction_type == 'expense'" class="badge bg-danger">
                                        Xarajat
                                    </span>
                                </td>
                                <td><span t-esc="rec.payment_type_id.name"/></td>
                                <td>
                                    <span t-esc="rec.amount"/> <span t-esc="rec.currency_id.name"/>
                                </td>
                                <td>
                                    <span class="badge bg-success" t-if="rec.state == 'confirmed'">Tasdiqlangan</span>
                                    <span class="badge bg-secondary" t-if="rec.state == 'draft'">Draft</span>
                                    <span class="badge bg-danger" t-if="rec.state == 'cancelled'">Bekor qilingan</span>
                                </td>
                            </tr>
                        </t>

                        <t t-if="not records">
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    Hozircha hech qanday hisobot mavjud emas.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- Pager -->
                <t t-call="portal.pager"/>

            </div>
        </t>
    </template>

</odoo>
