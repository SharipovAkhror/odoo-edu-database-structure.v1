<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_fb_page_list" model="ir.ui.view">
        <field name="name">fb.page.list</field>
        <field name="model">fb.page</field>
        <field name="arch" type="xml">
            <list string="Facebook Pages"
                  decoration-success="webhook_subscribed"
                  decoration-muted="not active">
                <field name="name"/>
                <field name="fb_page_id"/>
                <field name="form_count" string="Forms"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <field name="webhook_subscribed" string="Webhook"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_fb_page_form" model="ir.ui.view">
        <field name="name">fb.page.form</field>
        <field name="model">fb.page</field>
        <field name="arch" type="xml">
            <form string="Facebook Page">
                <header>
                    <button name="action_sync_forms" type="object"
                            string="Sync Forms" class="btn-secondary"/>
                    <button name="action_subscribe_webhook" type="object"
                            string="Subscribe Webhook" class="btn-primary"
                            invisible="webhook_subscribed"/>
                    <button name="action_unsubscribe_webhook" type="object"
                            string="Unsubscribe Webhook" class="btn-secondary"
                            invisible="not webhook_subscribed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_forms" type="object"
                                class="oe_stat_button" icon="fa-wpforms"
                                invisible="form_count == 0">
                            <field name="form_count" widget="statinfo" string="Forms"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">Page ID: <field name="fb_page_id" readonly="1"/></div>
                    </div>

                    <group>
                        <group string="Lead Routing (defaults)">
                            <field name="team_id"/>
                            <field name="user_id"/>
                        </group>
                        <group string="Status">
                            <field name="webhook_subscribed" readonly="1"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Lead Forms">
                            <field name="form_ids" nolabel="1">
                                <list string="Forms" decoration-muted="status == 'archived'">
                                    <field name="name"/>
                                    <field name="fb_form_id"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'active'"
                                           decoration-warning="status == 'archived'"/>
                                    <field name="team_id" optional="show"/>
                                    <field name="user_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_fb_pages" model="ir.actions.act_window">
        <field name="name">Facebook Pages</field>
        <field name="res_model">fb.page</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
