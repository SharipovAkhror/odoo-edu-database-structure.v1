<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="custom.elearning_dashboard" owl="1">
        <div class="o_el_dashboard">
            <div class="o_el_header">
                <h2>Ustudy eLearning Dashboardi</h2>
                <p class="o_el_subtitle">
                    Studentlar, Kurslar, Ta'lim darajasi and To'lov ma'lumotlari
                </p>
            </div>

            <!-- KPI ROW -->
            <div class="o_el_kpi_row">
                <div class="o_el_kpi_card">
                    <div class="o_el_kpi_label">Jami Talabalar</div>
                    <div class="o_el_kpi_value" id="kpi_total_students">0</div>
                </div>
                <div class="o_el_kpi_card">
                    <div class="o_el_kpi_label">Active Kurslar</div>
                    <div class="o_el_kpi_value" id="kpi_total_courses">0</div>
                </div>
                <div class="o_el_kpi_card">
                    <div class="o_el_kpi_label">O'rtacha o'zlashtirish</div>
                    <div class="o_el_kpi_value" id="kpi_avg_completion">0%</div>
                </div>
                <div class="o_el_kpi_card">
                    <div class="o_el_kpi_label">Oxirgi 30 kunlik Xisobotlar</div>
                    <div class="o_el_kpi_value" id="kpi_monthly_revenue">0</div>
                </div>
            </div>

            <!-- GRID FOR CHARTS -->
            <div class="o_el_grid">
                <div class="o_el_card">
                    <div class="o_el_card_header">
                        <span class="o_el_tag o_tag_enroll">Enrollments per day</span>
                    </div>
                    <div class="o_el_chart">
                        <canvas id="chart_enrollments_by_day"></canvas>
                    </div>
                </div>

                <div class="o_el_card">
                    <div class="o_el_card_header">
                        <span class="o_el_tag o_tag_course_students">Har bir kurs talabalari</span>
                    </div>
                    <div class="o_el_chart">
                        <canvas id="chart_students_by_course"></canvas>
                    </div>
                </div>

                <div class="o_el_card">
                    <div class="o_el_card_header">
                        <span class="o_el_tag o_tag_progress">O'rtacha o'zlashtirish har bir kurs uchun</span>
                    </div>
                    <div class="o_el_chart">
                        <canvas id="chart_avg_progress_by_course"></canvas>
                    </div>
                </div>

                <div class="o_el_card">
                    <div class="o_el_card_header">
                        <span class="o_el_tag o_tag_revenue">Oylik Tushumlar</span>
                    </div>
                    <div class="o_el_chart">
                        <canvas id="chart_revenue_by_month"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scoped CSS (DrukSmart style) -->
        <style>
            .o_el_dashboard {
                padding: 32px 40px;
                background: #020617;
                min-height: 100vh;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                color: #e5e7eb;
            }
            .o_el_header {
                margin-bottom: 24px;
            }
            .o_el_header h2 {
                font-size: 26px;
                font-weight: 700;
                color: #f9fafb;
                margin-bottom: 4px;
            }
            .o_el_subtitle {
                color: #9ca3af;
                font-size: 14px;
            }

            .o_el_kpi_row {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 16px;
                margin-bottom: 24px;
            }
            .o_el_kpi_card {
                background: radial-gradient(circle at top left, #1e293b, #020617);
                border-radius: 16px;
                padding: 16px 18px;
                box-shadow: 0 10px 30px rgba(15, 23, 42, 0.8);
                border: 1px solid rgba(148, 163, 184, 0.4);
            }
            .o_el_kpi_label {
                font-size: 11px;
                text-transform: uppercase;
                letter-spacing: 0.12em;
                color: #9ca3af;
                margin-bottom: 8px;
            }
            .o_el_kpi_value {
                font-size: 22px;
                font-weight: 700;
                color: #e5e7eb;
            }

            .o_el_grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
                gap: 24px;
            }
            .o_el_card {
                background: #020617;
                border-radius: 16px;
                box-shadow: 0 6px 18px rgba(15, 23, 42, 0.9);
                padding: 20px;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                border: 1px solid rgba(55, 65, 81, 0.8);
            }
            .o_el_card_header {
                margin-bottom: 10px;
            }
            .o_el_tag {
                display: inline-block;
                padding: 6px 12px;
                font-size: 12px;
                font-weight: 600;
                border-radius: 999px;
                color: #f9fafb;
                letter-spacing: 0.04em;
            }
            .o_tag_enroll {
                background: linear-gradient(90deg, #38bdf8, #6366f1);
            }
            .o_tag_course_students {
                background: linear-gradient(90deg, #f97316, #ec4899);
            }
            .o_tag_progress {
                background: linear-gradient(90deg, #22c55e, #14b8a6);
            }
            .o_tag_revenue {
                background: linear-gradient(90deg, #eab308, #f97316);
            }

            .o_el_chart {
                width: 100%;
                height: 280px;
                border-radius: 12px;
                background: #020617;
                position: relative;
                overflow: hidden;
            }
            .o_el_chart canvas {
                width: 100% !important;
                height: 100% !important;
            }

            @media (max-width: 768px) {
                .o_el_dashboard {
                    padding: 20px;
                }
                .o_el_chart {
                    height: 240px;
                }
            }
        </style>
    </t>
</templates>
