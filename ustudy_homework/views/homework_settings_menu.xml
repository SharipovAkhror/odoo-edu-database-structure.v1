<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- LIST (tree) add column -->
  <record id="view_slide_channel_tree_inherit_pass_ball" model="ir.ui.view">
    <field name="name">slide.channel.tree.inherit.pass.ball</field>
    <field name="model">slide.channel</field>
    <field name="inherit_id" ref="website_slides.slide_channel_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//tree/field[@name='name']" position="after">
        <field name="homework_pass_mark"/>
      </xpath>
    </field>
  </record>

  <!-- FORM add field -->
  <record id="view_slide_channel_form_inherit_pass_ball" model="ir.ui.view">
    <field name="name">slide.channel.form.inherit.pass.ball</field>
    <field name="model">slide.channel</field>
    <field name="inherit_id" ref="website_slides.slide_channel_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet//group" position="inside">
        <field name="homework_pass_mark"/>
      </xpath>
    </field>
  </record>

</odoo>
