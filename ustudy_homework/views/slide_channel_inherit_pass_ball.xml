<odoo>
  <record id="view_slide_channel_form_inherit_homework_pass" model="ir.ui.view">
    <field name="name">slide.channel.form.inherit.homework.pass</field>
    <field name="model">slide.channel</field>
    <field name="inherit_id" ref="website_slides.slide_channel_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet//group" position="inside">
        <field name="homework_pass_mark"/>
      </xpath>
    </field>
  </record>

  <record id="view_slide_channel_tree_inherit_homework_pass" model="ir.ui.view">
    <field name="name">slide.channel.tree.inherit.homework.pass</field>
    <field name="model">slide.channel</field>
    <field name="inherit_id" ref="website_slides.slide_channel_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//tree" position="inside">
        <field name="homework_pass_mark"/>
      </xpath>
    </field>
  </record>
</odoo>
