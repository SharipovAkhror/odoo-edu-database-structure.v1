<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- 1) Server action (first) - will open a new edu.homework form pre-filled with slide and course -->
  <record id="action_create_homework" model="ir.actions.server">
      <field name="name">Create Homework from Slide</field>
      <field name="model_id" ref="website_slides.model_slide_slide"/>
      <field name="state">code</field>
      <field name="code">
          action = {
              'type': 'ir.actions.act_window',
              'res_model': 'edu.homework',
              'view_mode': 'form',
              'target': 'new',
              'context': dict(env.context,
                  default_slide_id=record.id,
                  default_channel_id=record.channel_id.id
              ),
          }
      </field>
  </record>

  <!-- 2) Inherit the slide form (use the view id you confirmed earlier) -->
  <record id="view_slide_form_inherit_homework" model="ir.ui.view">
    <field name="name">slide.slide.form.inherit.homework</field>
    <field name="model">slide.slide</field>
    <field name="inherit_id" ref="website_slides.view_slide_slide_form_wo_channel_id"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Homeworks">
          <group>
            <button name="%(ustudy_homework.action_create_homework)d"
                type="action"
                string="Create Homework"
                class="oe_highlight"/>
            <!-- <button name="%(ustudy_homework.action_create_homework)d"
                    type="action"
                    string="Create Homework"
                    class="oe_highlight"/> -->
          </group>

          <!-- simple One2many listing — do NOT reference active_id here -->
          <field name="homework_ids">
            <list>
              <field name="name"/>
              <field name="teacher_id"/>
              <field name="due_date"/>
              <field name="is_published"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>

</odoo>
