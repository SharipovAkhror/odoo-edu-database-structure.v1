<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Remove sidebar from lesson page -->
  <template id="ustudy_remove_entire_sidebar"
            inherit_id="website_slides.lesson_main">

    <xpath expr="//aside[hasclass('o_wslides_lesson_aside')]" position="replace"/>

    <xpath expr="//div[hasclass('o_wslides_lesson_main')]" position="attributes">
      <attribute name="class">o_wslides_lesson_main col-lg-12</attribute>
    </xpath>

  </template>

</odoo>