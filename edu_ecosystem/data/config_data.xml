<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Default API key for the FaceID endpoint.
             IMPORTANT: Change this immediately after installation!
             An empty value means the endpoint is unprotected (dev mode). -->
        <record id="faceid_api_key_param" model="ir.config_parameter">
            <field name="key">edu_ecosystem.faceid_api_key</field>
            <field name="value"></field>
        </record>

        <!-- Turnstile time buffer (minutes before/after class time to accept entry) -->
        <record id="faceid_time_buffer_param" model="ir.config_parameter">
            <field name="key">edu_ecosystem.faceid_time_buffer_minutes</field>
            <field name="value">15</field>
        </record>

    </data>
</odoo>
