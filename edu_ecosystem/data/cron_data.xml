<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================
             CRON: Telegram Message Queue Processor
             Runs every 30 seconds. Dispatches pending messages to the
             Telegram Bot API with retry logic and exponential backoff.
        ============================================================ -->
        <record id="cron_telegram_queue_processor" model="ir.cron">
            <field name="name">Telegram: Process Message Queue</field>
            <field name="model_id" ref="model_telegram_message_queue"/>
            <field name="state">code</field>
            <field name="code">model._process_queue()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">seconds</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">1</field>
        </record>

        <!-- ============================================================
             CRON: Telegram Queue Cleanup
             Runs weekly. Deletes successfully sent messages older than
             30 days to prevent unbounded table growth.
        ============================================================ -->
        <record id="cron_telegram_queue_cleanup" model="ir.cron">
            <field name="name">Telegram: Cleanup Old Messages</field>
            <field name="model_id" ref="model_telegram_message_queue"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_old_messages()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="priority">100</field>
        </record>

    </data>
</odoo>
