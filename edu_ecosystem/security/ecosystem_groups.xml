<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             GROUP: Ecosystem Administrator
             Members can configure the FaceID API key, Telegram bot,
             and view all raw turnstile events.
        ============================================================ -->
        <record id="group_ecosystem_admin" model="res.groups">
            <field name="name">Ecosystem: Administrator</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can configure the FaceID API, Telegram bot settings,
                and access raw turnstile event logs.
            </field>
        </record>

        <!-- System administrators automatically get ecosystem admin rights. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('edu_ecosystem.group_ecosystem_admin'))]"/>
        </record>

    </data>
</odoo>
