         CONFIGURATION
    ============================================================ -->
    <menuitem id="menu_ecosystem_configuration"
              name="Configuration"
              parent="menu_ecosystem_root"
              sequence="100"/>

    <menuitem id="menu_telegram_config"
              name="Telegram Bot"
              parent="menu_ecosystem_configuration"
              action="action_telegram_bot_config"
