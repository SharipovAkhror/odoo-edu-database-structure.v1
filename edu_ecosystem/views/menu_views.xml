              name="Ecosystem"
              sequence="70"
              groups="edu_ecosystem.group_ecosystem_admin"/>

    <!-- ============================================================
         MONITORING
    ============================================================ -->
    <menuitem id="menu_ecosystem_monitoring"
              name="Monitoring"
              parent="menu_ecosystem_root"
              sequence="10"/>

    <menuitem id="menu_faceid_events"
              name="FaceID Events"
              parent="menu_ecosystem_monitoring"
