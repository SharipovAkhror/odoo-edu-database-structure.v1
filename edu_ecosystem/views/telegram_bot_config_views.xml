<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         TELEGRAM BOT CONFIG: FORM VIEW
    ============================================================ -->
    <record id="view_telegram_bot_config_form" model="ir.ui.view">
        <field name="name">telegram.bot.config.form</field>
        <field name="model">telegram.bot.config</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot Configuration">
                <header>
                    <button name="action_test_connection"
                            string="Test Connection"
                            type="object"
                            class="oe_highlight"/>
                    <button name="action_send_test_message"
                            string="Send Test Message"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="bot_name"/>
                        <h1>
                            <field name="bot_name" placeholder="e.g. UStudy Attendance Bot"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Connection">
                            <field name="bot_token" password="True"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Default Recipient">
                            <field name="default_admin_chat_id"
                                   placeholder="e.g. 123456789"/>
                        </group>
                    </group>

                    <group string="Statistics">
                        <group>
                            <field name="messages_sent" readonly="1"/>
                            <field name="messages_failed" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_send_datetime" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         TELEGRAM BOT CONFIG: LIST VIEW
    ============================================================ -->
    <record id="view_telegram_bot_config_list" model="ir.ui.view">
        <field name="name">telegram.bot.config.list</field>
        <field name="model">telegram.bot.config</field>
        <field name="arch" type="xml">
            <list string="Telegram Bots">
                <field name="bot_name" decoration-bf="1"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="messages_sent"/>
                <field name="messages_failed"/>
                <field name="last_send_datetime"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         TELEGRAM BOT CONFIG: ACTION
    ============================================================ -->
    <record id="action_telegram_bot_config" model="ir.actions.act_window">
        <field name="name">Telegram Bot</field>
        <field name="res_model">telegram.bot.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure your Telegram bot
            </p>
            <p>
                Get a bot token from @BotFather on Telegram, then configure
                it here to enable student entry/exit notifications.
            </p>
        </field>
    </record>

</odoo>
