<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         TELEGRAM QUEUE: FORM VIEW
    ============================================================ -->
    <record id="view_telegram_message_queue_form" model="ir.ui.view">
        <field name="name">telegram.message.queue.form</field>
        <field name="model">telegram.message.queue</field>
        <field name="arch" type="xml">
            <form string="Telegram Message" create="0">
                <sheet>
                    <group>
                        <group string="Delivery">
                            <field name="chat_id"/>
                            <field name="parse_mode"/>
                            <field name="state" widget="badge"
                                   decoration-warning="state == 'pending'"
                                   decoration-success="state == 'sent'"
                                   decoration-danger="state == 'failed'"/>
                            <field name="sent_datetime"/>
                        </group>
                        <group string="Retry">
                            <field name="attempt_count"/>
                            <field name="max_attempts"/>
                            <field name="next_retry_after"/>
                        </group>
                    </group>

                    <group string="Message Content">
                        <field name="message_text" readonly="1"/>
                    </group>

                    <group string="Error" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </group>

                    <group>
                        <group string="Source">
                            <field name="event_type" widget="badge"
                                   decoration-success="event_type == 'student_entered'"
                                   decoration-info="event_type == 'student_left'"
                                   decoration-warning="event_type in ('balance_warning', 'no_class_alert')"
                                   decoration-muted="event_type == 'system_alert'"/>
                            <field name="event_id"/>
                            <field name="student_id"/>
                        </group>
                        <group string="Meta">
                            <field name="create_date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================
         TELEGRAM QUEUE: LIST VIEW
    ============================================================ -->
    <record id="view_telegram_message_queue_list" model="ir.ui.view">
        <field name="name">telegram.message.queue.list</field>
        <field name="model">telegram.message.queue</field>
        <field name="arch" type="xml">
            <list string="Telegram Queue" create="0"
                  decoration-warning="state == 'pending'"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'failed'">
                <field name="create_date" string="Queued"/>
                <field name="event_type" widget="badge"
                       decoration-success="event_type == 'student_entered'"
                       decoration-info="event_type == 'student_left'"
                       decoration-warning="event_type in ('balance_warning', 'no_class_alert')"/>
                <field name="student_id"/>
                <field name="chat_id"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
                <field name="attempt_count"/>
                <field name="sent_datetime" optional="show"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         TELEGRAM QUEUE: SEARCH VIEW
    ============================================================ -->
    <record id="view_telegram_message_queue_search" model="ir.ui.view">
        <field name="name">telegram.message.queue.search</field>
        <field name="model">telegram.message.queue</field>
        <field name="arch" type="xml">
            <search string="Search Queue">
                <field name="student_id"/>
                <field name="chat_id"/>
                <field name="event_type"/>
                <separator/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Sent" name="filter_sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter string="Failed" name="filter_failed"
                        domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <!-- ============================================================
         TELEGRAM QUEUE: ACTION
    ============================================================ -->
    <record id="action_telegram_message_queue" model="ir.actions.act_window">
        <field name="name">Telegram Queue</field>
        <field name="res_model">telegram.message.queue</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_telegram_message_queue_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Telegram queue is empty
            </p>
            <p>
                Messages appear here when the FaceID turnstile logs a student
                event. A cron job dispatches them every 30 seconds.
            </p>
        </field>
    </record>

</odoo>
