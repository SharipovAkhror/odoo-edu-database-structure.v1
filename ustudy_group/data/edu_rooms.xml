<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE/LIST VIEW -->
    <record id="view_edu_room_tree" model="ir.ui.view">
        <field name="name">edu.room.list</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <list string="Rooms" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_edu_room_form" model="ir.ui.view">
        <field name="name">edu.room.form</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Room Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Room 101"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="capacity"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <group string="Additional Information">
                        <field name="description" placeholder="Room details, equipment, etc." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="view_edu_room_search" model="ir.ui.view">
        <field name="name">edu.room.search</field>
        <field name="model">edu.room</field>
        <field name="arch" type="xml">
            <search string="Rooms">
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_edu_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">edu.room</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_edu_room_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first room
            </p>
            <p>
                Add rooms that can be used for classes and groups.
            </p>
        </field>
    </record>

</odoo>