<odoo>
    <record id="view_partner_form_groups_button" model="ir.ui.view">
        <field name="name">res.partner.form.groups.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="ustudy_student.view_student_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_view_groups"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        invisible="not is_student or group_count == 0">

                    <field name="group_count"
                           widget="statinfo"
                           string="Guruh"/>
                </button>

            </xpath>
        </field>
    </record>
</odoo>
